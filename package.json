{
  "name": "alrevolutum-website",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "dev:cloudflare": "npx astro build && npx wrangler dev",
    "clean:cache": "rm -rf node_modules/.astro/assets && rm -rf .astro  && rm -rf .wrangler/state",
    "deploy:cloudflare": "npm run clean:cache && npx astro build && npx wrangler deploy",
    "deploy:preview": "npm run clean:cache && npx astro build && npx wrangler versions upload",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.2.6",
    "@astrojs/markdown-remark": "7.3.0",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.2.10",
    "mdast-util-to-string": "4.0.0",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "7.1.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "rehype-mermaid": "3.0.0",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  }
}
